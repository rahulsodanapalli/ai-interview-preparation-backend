# Application Configuration
APP_NAME="AI Interview Preparation Platform"
APP_ENV=development
API_V1_PREFIX=/api/v1

# CORS Allowed Origins (comma-separated or JSON list for frontend integration)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Ollama LLM Service Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60.0

# Database Configuration (Neon PostgreSQL)
# Example: postgresql+psycopg://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Document Ingestion Configuration
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_PDF_PAGES=100

# Pinecone Vector Database Configuration (RAG Phase 4)
# Get your API key from https://app.pinecone.io/
PINECONE_API_KEY=pcsk_8kk89_JBUKEUBnu4StrqCzxmPuY1ZK4JszCbSzfRQ9PifPsKfZmveS2gue5wWFnWnwR8c
PINECONE_INDEX_NAME=ai-interview-prep-dense-768
