# Application Configuration
APP_NAME="AI Interview Preparation Platform"
APP_ENV=development
API_V1_PREFIX=/api/v1

# CORS Allowed Origins (comma-separated or JSON list for frontend integration)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
FRONTEND_URL=http://localhost:5173

# Authentication & JWT Security
# Required in production (minimum 32 random characters; generate with: openssl rand -hex 32)
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_REMEMBER_ME_DAYS=30

# Google OAuth 2.0 Configuration
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized JavaScript origin: http://localhost:5173
# Authorized redirect URI: http://localhost:5173/auth/callback
#   (Frontend /auth/callback route exchanges the code via POST /api/v1/auth/google/callback)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Auth Rate Limiting (requests per window per IP)
AUTH_RATE_LIMIT_MAX_ATTEMPTS=15
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Ollama LLM & Embedding Service Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CONNECT_TIMEOUT_SECONDS=10.0
OLLAMA_TIMEOUT_SECONDS=120.0
OLLAMA_CHAT_TIMEOUT_SECONDS=180.0
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048
OLLAMA_MAX_CONCURRENT_CHATS=1

# Database Configuration (Neon PostgreSQL)
# Required when APP_ENV=production
# Example: postgresql+psycopg://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true
DB_ECHO=false

# Document Ingestion & Chunking Configuration
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_PDF_PAGES=100
CHUNK_SIZE=2000
CHUNK_OVERLAP=200

# Pinecone Vector Database Configuration
# Get your API key from https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=ai-interview-prep-v2
PINECONE_DIMENSION=768
PINECONE_METRIC=cosine
PINECONE_NAMESPACE=default
PINECONE_TOP_K=4

# Advanced RAG Retrieval & Reranking Configuration
RAG_MIN_RELEVANCE_SCORE=0.55
RAG_ENABLE_HYBRID_SEARCH=true
RAG_HYBRID_ALPHA=0.5
RAG_CANDIDATE_POOL_SIZE=15
RAG_ENABLE_RERANKING=true
RAG_RERANKER_TYPE=auto

# GitHub MCP Integration
# Optional GitHub Personal Access Token (PAT) for authenticated repository access.
# Minimum permissions recommended:
#   - Fine-grained PAT -> Only selected repositories -> Repository permissions:
#       - Contents: Read-only
#       - Metadata: Read-only
# If omitted, public repositories are accessed unauthenticated via standard MCP stdio.
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT_SECONDS=15.0
GITHUB_MCP_SERVER_COMMAND=
GITHUB_MCP_TIMEOUT_SECONDS=30.0
GITHUB_MAX_FILE_SIZE_BYTES=512000
