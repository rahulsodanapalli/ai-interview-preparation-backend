# Application Configuration
APP_NAME="AI Interview Preparation Platform"
APP_ENV=development
API_V1_PREFIX=/api/v1

# CORS Allowed Origins (comma-separated or JSON list for frontend integration)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Ollama LLM & Embedding Service Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60.0

# Database Configuration (Neon PostgreSQL)
# Example: postgresql+psycopg://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Document Ingestion & Chunking Configuration
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_PDF_PAGES=100
CHUNK_SIZE=2000
CHUNK_OVERLAP=200

# Pinecone Vector Database Configuration
# Get your API key from https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=ai-interview-prep-v2
PINECONE_DIMENSION=768
PINECONE_METRIC=cosine
PINECONE_NAMESPACE=default
PINECONE_TOP_K=4

# Advanced RAG Retrieval & Reranking Configuration
RAG_MIN_RELEVANCE_SCORE=0.55
RAG_ENABLE_HYBRID_SEARCH=true
RAG_HYBRID_ALPHA=0.5
RAG_CANDIDATE_POOL_SIZE=15
RAG_ENABLE_RERANKING=true
RAG_RERANKER_TYPE=auto

# GitHub MCP Integration
# Optional GitHub Personal Access Token (PAT) for authenticated repository access.
# Minimum permissions recommended:
#   - Fine-grained PAT -> Only selected repositories -> Repository permissions:
#       - Contents: Read-only
#       - Metadata: Read-only
# If omitted, public repositories are accessed unauthenticated via standard MCP stdio.
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT_SECONDS=15.0
GITHUB_MCP_SERVER_COMMAND=
GITHUB_MCP_TIMEOUT_SECONDS=30.0
GITHUB_MAX_FILE_SIZE_BYTES=512000
